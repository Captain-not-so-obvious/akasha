generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Para o pooler do Supabase (pgBouncer), é necessário o directUrl
  // para que as migrations funcionem corretamente
  directUrl = env("DIRECT_URL")
}

enum FriendshipStatus {
  pending
  accepted
  declined
  blocked
}

enum ActivityVisibility {
  friends
  private
}

model Profile {
  id                  String             @id @db.Uuid
  email               String?            @unique
  username            String?            @unique
  avatarUrl           String?            @map("avatar_url")
  friendCode          String?            @unique @map("friend_code")
  activityVisibility  ActivityVisibility @default(friends) @map("activity_visibility")
  discoverableByEmail Boolean            @default(false)   @map("discoverable_by_email")
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at")
  wishlists           Wishlist[]
  oauthCodes          OAuthCode[]
  mcpGrants           McpGrant[]
  consentRecords      ConsentRecord[]
  activities          Activity[]
  sentFriendships     Friendship[]       @relation("SentFriendships")
  receivedFriendships Friendship[]       @relation("ReceivedFriendships")
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]

  @@map("profiles")
}

model Friendship {
  id           Int              @id @default(autoincrement())
  requesterId  String           @map("requester_id") @db.Uuid
  addresseeId  String           @map("addressee_id") @db.Uuid
  status       FriendshipStatus @default(pending)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at")

  requester    Profile          @relation("SentFriendships", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee    Profile          @relation("ReceivedFriendships", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

model OAuthCode {
  id            String   @id @default(uuid())
  code          String   @unique
  userId        String   @db.Uuid @map("user_id")
  clientId      String   @map("client_id")
  redirectUri   String   @map("redirect_uri")
  codeChallenge String?  @map("code_challenge")
  scope         String   @default("mcp:read mcp:write")
  expiresAt     DateTime @map("expires_at")
  used          Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  profile       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("oauth_codes")
}

model McpGrant {
  id         String    @id @default(uuid())
  userId     String    @map("user_id") @db.Uuid
  clientId   String    @map("client_id")
  scope      String    @default("mcp:read mcp:write")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  profile    Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("mcp_grants")
}

model ConsentRecord {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.Uuid
  document   String   // 'terms' | 'privacy'
  version    String   // ex: '2026-10-01'
  acceptedAt DateTime @default(now()) @map("accepted_at")

  profile    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, document])
  @@map("consent_records")
}

enum DomainType {
  movie
  tv
  game
  book
  comic
}

enum MediaType {
  movie
  tv
}

enum WatchStatus {
  plan_to_watch
  watching
  completed
  dropped
}

model Wishlist {
  id          Int         @id @default(autoincrement())
  userId      String      @map("user_id") @db.Uuid
  domain      DomainType  @default(movie)
  externalId  String      @default("") @map("external_id")
  tmdbId      Int?        @map("tmdb_id")
  mediaType   MediaType?  @map("media_type")
  status      WatchStatus @default(plan_to_watch)
  userRating  Int?        @map("user_rating") // 1-5, validado via Zod no backend
  notes       String?
  title       String      @default("Sem título")
  coverUrl    String?     @map("cover_url")
  releaseYear Int?        @map("release_year")
  extraMeta   Json?       @map("extra_meta")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at")
  profile     Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain, externalId])
  @@index([userId, domain, status])
  @@map("wishlist")
}

enum ActivityType {
  ADDED_TO_LIST
  STATUS_CHANGED
  RATED_MEDIA
}

model Activity {
  id         Int          @id @default(autoincrement())
  userId     String       @map("user_id") @db.Uuid
  type       ActivityType
  domain     DomainType   @default(movie)
  externalId String       @default("") @map("external_id")
  tmdbId     Int?         @map("tmdb_id")
  mediaType  MediaType?   @map("media_type")
  title      String?
  posterPath String?      @map("poster_path")
  userRating Int?         @map("user_rating")
  status     WatchStatus?
  review     String?      // Opinião / Resenha opcional do usuário (máx 300 chars)
  createdAt  DateTime     @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("activities")
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FRIEND_RATED
  NEW_EPISODE
  SYSTEM
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  profile   Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

