# ============================================================
# SERVIDOR
# ============================================================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ============================================================
# BANCO DE DADOS (Prisma)
# ============================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?pgbouncer=true"

# Conexão direta — necessária para migrations
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"

# ============================================================
# TMDB — Obtenha em: https://www.themoviedb.org/settings/api
# ============================================================
TMDB_READ_ACCESS_TOKEN=

# ============================================================
# SUPABASE — Supabase > Settings > API > JWT Settings > JWT Secret
# ============================================================
SUPABASE_JWT_SECRET=

# ============================================================
# IGDB / TWITCH — Obtenha em: https://dev.twitch.tv/console/apps
# ============================================================
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ============================================================
# GOOGLE BOOKS (Opcional - Akasha usa Open Library como fallback automático)
# Obtenha em: https://console.cloud.google.com/apis/credentials (Ativar "Books API")
# ============================================================
GOOGLE_BOOKS_API_KEY=
