# ============================================================
# SERVIDOR
# ============================================================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ============================================================
# BANCO DE DADOS (Prisma)
# ============================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?pgbouncer=true"

# Conexão direta — necessária para migrations
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"

# ============================================================
# TMDB — Obtenha em: https://www.themoviedb.org/settings/api
# ============================================================
TMDB_READ_ACCESS_TOKEN=

# ============================================================
# SUPABASE — Supabase > Settings > API > JWT Settings > JWT Secret
# ============================================================
SUPABASE_JWT_SECRET=
